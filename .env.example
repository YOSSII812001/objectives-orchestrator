# =============================================================================
# objectives-orchestrator 環境変数サンプル
# このファイルを `.env` にコピーして値を埋めてください。
# `.env` 本体は .gitignore により git 管理対象外です。
# =============================================================================

# --- LM Studio API ---
# ローカルLLMサーバーのエンドポイント
LMS_BASE_URL=http://localhost:1234/v1
# LM Studio にロード済みのモデル ID（例: google/gemma-4-e4b, openai/gpt-oss-20b）
LMS_MODEL=google/gemma-4-e4b

# --- Brave Search API ---
# https://api-dashboard.search.brave.com/ で取得
# Free tier: 2,000 queries/month、1 query/sec
BRAVE_API_KEY=your_brave_api_key_here

# --- Obsidian Vault パス ---
# 未指定の場合は ~/Documents/Obsidian Vault を使用
# VAULT_PATH=C:\Users\YourName\Documents\Obsidian Vault
# VAULT_PATH=/home/user/Documents/ObsidianVault

# --- agent-browser（オプション、現在未使用） ---
# Chrome 互換性問題のため MVP では Brave Search API を使用。
# 将来有効化する場合にフルパスを指定。
# AGENT_BROWSER_CMD=C:\Users\YourName\AppData\Roaming\npm\agent-browser.cmd
